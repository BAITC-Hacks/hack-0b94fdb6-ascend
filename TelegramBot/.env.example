# Paste ONLY a newly rotated token into your local .env, never into Git or chat.
TELEGRAM_BOT_TOKEN=
# SHA-256 of a random team activation code; generated by local setup.
TEAM_ACCESS_HASH=
BACKEND_URL=http://127.0.0.1:8000
BACKEND_API_TOKEN=
DASHBOARD_URL=
POLL_SECONDS=60
MIN_PRIORITY=0
# Real data requires explicit organizational approval for Telegram notifications.
ALLOW_REAL_DATA=0
# Keep 0 unless transfer of client identifiers/amounts has been approved.
INCLUDE_CLIENT_DETAILS=0
